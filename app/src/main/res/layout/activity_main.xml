<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center_vertical"
            android:background="#F0FFFFFF"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/menuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu"
                android:textSize="12sp" />

            <Button
                android:id="@+id/connectSerialButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/connect"
                android:textSize="12sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/fixStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_fix"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/satCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sats"
                        android:textSize="10sp"
                        android:textColor="@android:color/black" />
                    <TextView
                        android:id="@+id/rtkAgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/age"
                        android:textSize="10sp"
                        android:textColor="@android:color/black" />
                    <TextView
                        android:id="@+id/altText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/alt"
                        android:textSize="10sp"
                        android:textColor="@android:color/black" />
                    <TextView
                        android:id="@+id/speedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0 km/h"
                        android:textSize="10sp"
                        android:textColor="@android:color/black" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/followSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/follow"
                android:textSize="10sp" />

            <Button
                android:id="@+id/measureButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/meas"
                android:textSize="12sp" />

        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/drawingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0EEEEEE"
            app:layout_constraintTop_toBottomOf="@id/topBar">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">
                <Button
                    android:id="@+id/drawPointButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/draw_pt"
                    android:textSize="10sp" />
                <Button
                    android:id="@+id/addPointAtPosButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/add_pt_gnss"
                    android:textSize="10sp" />
                <Button
                    android:id="@+id/drawLineButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/draw_line"
                    android:textSize="10sp" />
                <Button
                    android:id="@+id/drawPolyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/draw_poly"
                    android:textSize="10sp" />
                <Button
                    android:id="@+id/editFeatureButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/edit"
                    android:textSize="10sp" />
                <Button
                    android:id="@+id/clearDrawButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/clear"
                    android:textSize="10sp" />
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_magnet"
                    app:tint="#000000" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/snapSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/snap"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/drawingBar"
            app:layout_constraintBottom_toTopOf="@id/statusContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#A0FFFFFF"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginBottom="80dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_prefix"
                android:textColor="@android:color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <de.witt3d_gis.ScaleBarView
            android:id="@+id/scaleBar"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@id/zoomControls"
            app:layout_constraintEnd_toEndOf="parent" />

        <FrameLayout
            android:id="@+id/distanceArrow"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:id="@+id/arrowIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_nav_arrow"
                app:tint="#80FF0000" />
            <TextView
                android:id="@+id/distanceArrowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:shadowColor="@android:color/black"
                android:shadowRadius="3.0"
                android:shadowDx="1"
                android:shadowDy="1" />
        </FrameLayout>

        <TextView
            android:id="@+id/coordsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:background="#80FFFFFF"
            android:padding="2dp"
            android:text="0.000000, 0.000000"
            android:textColor="@android:color/black"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@id/mapView"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/zoomControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/coordsText"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/zoomInButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="20sp"
                android:backgroundTint="#80FFFFFF"
                android:textColor="@android:color/black"
                android:padding="0dp" />

            <Button
                android:id="@+id/zoomOutButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="-"
                android:textSize="20sp"
                android:backgroundTint="#80FFFFFF"
                android:textColor="@android:color/black"
                android:padding="0dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white">

        <LinearLayout
            android:id="@+id/nav_content_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Baud:"
                    android:textSize="12sp" />
                <Spinner
                    android:id="@+id/baudSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NTRIP &amp; WMS Settings"
                android:textSize="10sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gis_menu"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layers"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/styleRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wms_layers"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/addWmsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wmsLayerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_data"
                android:textStyle="bold" />

            <Button
                android:id="@+id/importCsvSide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_csv"
                android:textSize="10sp" />

            <Button
                android:id="@+id/importFileSide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_gis_file"
                android:textSize="10sp" />

            <Button
                android:id="@+id/exportDataSide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_data"
                android:textSize="10sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginVertical="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/display_settings"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/scaleModeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/relative_scale"
                android:textSize="10sp" />

            <Spinner
                android:id="@+id/crsSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
